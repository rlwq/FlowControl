{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "FlowControlModel/FlowControlModel.csproj",
            "FlowControlBusiness/FlowControlBusiness.csproj",
            "FlowControlGodotClient/FlowControlGodotClient.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "FlowControl",
      "_appTitle": "FlowControl",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
